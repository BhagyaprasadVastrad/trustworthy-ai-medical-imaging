   "source": [
    "# Create a 2-by-5 grid so that we can look at 10 example X-rays.\n",
    "fig, axes = plt.subplots(2, 5, figsize=(12, 5))\n",
    "\n",
    "\n",
    "# Go through each position in the grid.\n",
